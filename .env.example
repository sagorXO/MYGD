# Supabase PostgreSQL Connection Strings (Project: MYGD, Region: eu-central-1)
# 1. Transaction Pooler (port 6543) - used by serverless Next.js API runtime
DATABASE_URL="postgresql://postgres.edsttfdxvyllsolijpjq:[YOUR-DATABASE-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Connection (port 5432) - used by Prisma CLI for migrations and db push
DIRECT_URL="postgresql://postgres.edsttfdxvyllsolijpjq:[YOUR-DATABASE-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Next.js Application Environment Variables
NEXT_PUBLIC_DEFAULT_LOCATION="EMBA"
NEXT_PUBLIC_DEFAULT_TERMINAL="KIOSK-01"
NEXT_PUBLIC_CYPRUS_VAT_RATE="0.19"
NEXT_PUBLIC_STORE_CURRENCY="EUR"
