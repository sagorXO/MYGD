# MYGD environment template — copy to .env and fill in. Never commit real values.
# Only variables the code actually reads are listed here.

# ── Database (PostgreSQL; engine/hosting decision: docs/open-questions.md Q-DB-1) ──
# Runtime connection (pooled if a pooler is used)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection — used by the Prisma CLI (generate, migrate, db push)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Server ──
PORT=3000
NODE_ENV="development"

# ── Auth (Phase 0.5, not used yet) — generate with: openssl rand -hex 32 ──
SESSION_SECRET=""

# ── Kitchen printers (ESC/POS over raw TCP; models unknown: Q-HW-1) ──
# Leave empty to use the built-in defaults in src/modules/printer/tcp-spooler.ts.
PRINTER_INDOOR_IP=""
PRINTER_INDOOR_PORT=9100
PRINTER_GRILL_IP=""
PRINTER_GRILL_PORT=9100

# ── Optional ──
# Separate in-store SSE gateway; leave empty to use /api/events on this server.
NEXT_PUBLIC_MGD_EDGE_URL=""
# Base URL for `npm run ui:smoke` (Playwright screenshots).
UI_SMOKE_URL=""
