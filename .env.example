# Local development only. Copy to .env and fill in. Never commit real values.
# On the server, deploy/install.sh writes deploy/.env instead.

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mygd"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/mygd"

# Generate with: openssl rand -hex 32
SESSION_SECRET=""

# Folder for uploaded ad images and videos (outside the repository; back it up)
MEDIA_ROOT=""
# Optional upload limit in bytes (default 104857600 = 100 MB)
AD_MEDIA_MAX_BYTES=""
