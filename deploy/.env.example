# Copy to deploy/.env on the server (chmod 600). Never commit it.
# Generate each secret with: openssl rand -hex 32

DOMAIN=screens.example.com
ACME_EMAIL=you@example.com

# Hex only, so it is safe inside the database URL.
DB_PASSWORD=
SESSION_SECRET=

# Optional upload limit in bytes (default 104857600 = 100 MB; Caddy allows up to 110 MB).
AD_MEDIA_MAX_BYTES=

# Image version label, for rollbacks.
IMAGE_TAG=latest
