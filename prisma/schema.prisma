// MY GERMAN DÖNER — Master Connected Operations Schema
// Covers Modules M1 to M11 (Layer 2 In-Store Edge + Layer 3 Cloud HQ)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// 1. MULTI-LOCATION TENANCY & HARDWARE TERMINALS
// ---------------------------------------------------------

model Location {
  id        String   @id @default(cuid())
  slug      String   @unique // e.g. "EMBA", "LIMASSOL"
  name      String // "MY GERMAN DÖNER — Emba (Paphos)"
  nameDE    String?
  nameGR    String?
  address   String
  city      String   @default("Paphos")
  country   String   @default("CY")
  currency  String   @default("EUR")
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terminals      Terminal[]
  locationPrices LocationPrice[]
  orders         Order[]
  auditLogs      AuditLog[]
  inventoryItems InventoryItem[]
  checklistLogs  ChecklistLog[]
  haccpLogs      HaccpLog[]
  shiftSchedules ShiftSchedule[]
  timeLogs       TimeLog[]
  staffShifts    StaffShift[]
  supplierOrders SupplierOrder[]

  @@index([slug])
  @@index([isActive])

  checklistRuns ChecklistRun[]
  stockCounts   StockCount[]
}

model Terminal {
  id              String       @id @default(cuid())
  locationId      String
  terminalCode    String // e.g. "KIOSK-01", "POS-01", "KDS-01", "DISPLAY-01"
  terminalType    TerminalType @default(KIOSK)
  ipAddress       String?
  macAddress      String?
  printerType     PrinterType  @default(EPSON_TM)
  printerIp       String?
  printerPort     Int          @default(9100)
  autoCutReceipt  Boolean      @default(true)
  kioskModeLocked Boolean      @default(true)
  isActive        Boolean      @default(true)
  lastHeartbeat   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  location  Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  orders    Order[]
  auditLogs AuditLog[]

  @@unique([locationId, terminalCode])
  @@index([locationId])
  @@index([isActive])
}

enum TerminalType {
  KIOSK
  POS_COUNTER
  KITCHEN_DISPLAY
  MANAGER_TABLET
  CUSTOMER_DISPLAY
  MENU_BOARD
}

enum PrinterType {
  EPSON_TM
  STAR_MICRONICS
  SIMULATED_SCREEN
}

// ---------------------------------------------------------
// 2. MASTER PRODUCT CATALOG & PRICING (M11)
// ---------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique // "doner-kebab", "doner-box", "durum-wraps", "sides", "drinks"
  name        String // English
  nameDE      String // German
  nameGR      String // Greek
  description String?
  iconSvg     String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([sortOrder])
  @@index([isActive])
}

model Product {
  id               String      @id @default(cuid())
  categoryId       String
  sku              String      @unique // e.g. "MYGD-CL-DONER"
  name             String
  nameDE           String?
  nameGR           String?
  description      String?
  descriptionDE    String?
  descriptionGR    String?
  basePrice        Decimal     @db.Decimal(10, 2) // Default EUR base price (e.g. 7.50)
  imageUrl         String?
  badge            String? // "POPULAR", "NEW", "VEGGIE", "SPICY", "CHEF_CHOICE"
  calories         Int?
  allergens        String? // JSON array: ["Gluten", "Dairy", "Sesame"]
  vatCategory      VatCategory @default(FOOD_BEV)
  isVeggie         Boolean     @default(false)
  isSpicy          Boolean     @default(false)
  isAvailable      Boolean     @default(true)
  allowMealUpgrade Boolean     @default(true)
  sortOrder        Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifierGroups ProductModifierGroup[]
  locationPrices LocationPrice[]
  orderItems     OrderItem[]
  recipes        Recipe[]
  recipeBoms     RecipeBOM[]
  buildSheets    RecipeStep[]

  @@index([categoryId])
  @@index([isAvailable])
  @@index([sortOrder])
}

model LocationPrice {
  id          String   @id @default(cuid())
  locationId  String
  productId   String
  price       Decimal  @db.Decimal(10, 2) // Location-specific price override
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([locationId])
  @@index([productId])
}

// ---------------------------------------------------------
// 3. MODIFIERS & CUSTOMIZATION RULES
// ---------------------------------------------------------

model ModifierGroup {
  id          String   @id @default(cuid())
  slug        String   @unique // "meat-choice", "bread-choice", "sauces", "extras"
  name        String
  nameDE      String?
  nameGR      String?
  minSelected Int      @default(0)
  maxSelected Int      @default(1)
  isRequired  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modifiers Modifier[]
  products  ProductModifierGroup[]

  @@index([sortOrder])
}

model Modifier {
  id              String   @id @default(cuid())
  modifierGroupId String
  slug            String
  name            String
  nameDE          String?
  nameGR          String?
  priceAdjustment Decimal  @default(0.00) @db.Decimal(10, 2)
  isDefault       Boolean  @default(false)
  isAvailable     Boolean  @default(true)
  calories        Int?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modifierGroup ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderItemMods OrderItemModifier[]

  @@unique([modifierGroupId, slug])
  @@index([modifierGroupId])
  @@index([isAvailable])
}

model ProductModifierGroup {
  id              String   @id @default(cuid())
  productId       String
  modifierGroupId String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, modifierGroupId])
  @@index([productId])
  @@index([modifierGroupId])
}

// ---------------------------------------------------------
// 4. GRAM-PRECISION BILL OF MATERIALS (BOM) & INVENTORY (M3)
// ---------------------------------------------------------

model Ingredient {
  id             String   @id @default(cuid())
  sku            String   @unique // "ING-BEEF-SPIT", "ING-FLADENBROT"
  name           String
  unit           String   @default("GRAMS") // "GRAMS", "PIECES", "MILLILITERS"
  costPerUnitEUR Decimal  @default(0.0000) @db.Decimal(10, 4)
  supplierId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  recipeIngredients RecipeIngredient[]
  recipeBoms        RecipeBOM[]
  inventoryItems    InventoryItem[]

  @@index([sku])
}

model Recipe {
  id            String   @id @default(cuid())
  productId     String
  variantName   String   @default("STANDARD_150G")
  yieldServings Int      @default(1)
  prepTimeSec   Int      @default(180)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@index([productId])
}

model RecipeIngredient {
  id           String   @id @default(cuid())
  recipeId     String
  ingredientId String
  amountUnits  Float // e.g. 150.0 grams of meat, 1.0 piece of bread
  isOptional   Boolean  @default(false)
  createdAt    DateTime @default(now())

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
}

model RecipeBOM {
  id           String   @id @default(cuid())
  productId    String
  ingredientId String
  amountGrams  Float // Gram-level portion weight (e.g. 150.0g spit meat)
  isOptional   Boolean  @default(false)
  createdAt    DateTime @default(now())

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@index([productId])
  @@index([ingredientId])
}

model InventoryItem {
  id               String    @id @default(cuid())
  locationId       String
  ingredientId     String
  currentStock     Float     @default(0.0)
  minThreshold     Float     @default(5000.0) // In unit (e.g. 5000g = 5kg)
  reorderBatchSize Float     @default(20000.0)
  lastRestockedAt  DateTime?
  updatedAt        DateTime  @updatedAt

  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([locationId, ingredientId])
  @@index([locationId])
  @@index([ingredientId])
}

// ---------------------------------------------------------
// 5. M8: MCDONALD'S-STYLE VISUAL BUILD SHEETS
// ---------------------------------------------------------

model RecipeStep {
  id            String   @id @default(cuid())
  productId     String
  stepNumber    Int
  instruction   String
  instructionDE String?
  imageUrl      String?
  targetSec     Int      @default(30)
  qualityCheck  String? // e.g. "Ensure internal meat temp > 75°C"
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, stepNumber])
  @@index([productId])
}

// ---------------------------------------------------------
// 6. M2: SUPPLIER 1-TAP REORDERING & DISPATCH
// ---------------------------------------------------------

model Supplier {
  id            String   @id @default(cuid())
  name          String // "Berlin Döner Fleischerei GmbH", "Paphos Fresh Bakery"
  category      String // "MEAT", "BAKERY", "PRODUCE", "SAUCES", "PACKAGING"
  contactName   String?
  whatsApp      String // e.g. "+35799112233"
  email         String
  leadTimeHours Int      @default(24)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  ingredients    Ingredient[]
  supplierOrders SupplierOrder[]

  @@index([category])
}

model SupplierOrder {
  id               String    @id @default(cuid())
  locationId       String
  supplierId       String
  orderNumber      String    @unique // e.g. "SUP-EMBA-20260820-001"
  status           String    @default("PENDING") // PENDING, SENT_WHATSAPP, CONFIRMED, DELIVERED
  totalEUR         Decimal   @default(0.00) @db.Decimal(10, 2)
  itemsJson        String // JSON snapshot of ordered quantities and SKUs
  pinApprovalToken String? // Token generated when >€250 approval is required
  approvedByPin    String? // 4-digit PIN of owner (Rico / Oliver)
  dispatchedAt     DateTime?
  expectedDelivery DateTime?
  createdAt        DateTime  @default(now())

  location Location @relation(fields: [locationId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([locationId, status])
  @@index([supplierId])
}

// ---------------------------------------------------------
// 7. M1: DIGITAL CHECKLISTS & HACCP LOGBOOK
// ---------------------------------------------------------

model ChecklistTemplate {
  id        String   @id @default(cuid())
  title     String // "Morning Opening SOP", "HACCP Temperature Audit", "Night Closing"
  shiftType String // "OPENING", "MID_DAY", "CLOSING", "HACCP"
  tasksJson String // JSON list of required checks and temperature targets
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ChecklistLog {
  id          String   @id @default(cuid())
  locationId  String
  shiftType   String
  completedBy String // Staff name or ID
  isCompliant Boolean  @default(true)
  logsJson    String // Recorded values, temperature logs, photos
  notes       String?
  createdAt   DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId, createdAt])
}

model HaccpLog {
  id               String   @id @default(cuid())
  locationId       String
  equipmentName    String // "Walk-in Fridge 1", "Deep Freezer", "Rotisserie Spit"
  targetType       String // "CHILLED" (0-5°C), "FROZEN" (-18 to -22°C), "HOT_HOLDING" (>=63°C)
  temperature      Float // Recorded temperature in Celsius
  isCompliant      Boolean // True if within statutory limits
  correctiveAction String? // Mandatory explanation if in Danger Zone (5°C - 63°C)
  loggedBy         String // Staff name or PIN
  createdAt        DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId, createdAt])
  @@index([isCompliant])
}

// ---------------------------------------------------------
// 8. M7: SHIFT SCHEDULING & PIN TIMECLOCK
// ---------------------------------------------------------

model ShiftSchedule {
  id          String   @id @default(cuid())
  locationId  String
  staffId     String
  staffName   String
  role        String // "CASHIER", "GRILL_MASTER", "ASSEMBLER", "MANAGER"
  startTime   DateTime
  endTime     DateTime
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId, startTime])
}

model TimeLog {
  id           String    @id @default(cuid())
  locationId   String
  staffId      String
  staffName    String
  role         String
  clockIn      DateTime  @default(now())
  clockOut     DateTime?
  totalMinutes Int?
  isApproved   Boolean   @default(false)

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId, staffId])
  @@index([clockIn])
}

model StaffShift {
  id           String    @id @default(cuid())
  locationId   String
  staffId      String
  staffName    String
  role         String // "CASHIER", "GRILL_MASTER", "ASSEMBLER", "MANAGER"
  pin          String? // 4-digit PIN used for timeclock
  clockIn      DateTime  @default(now())
  clockOut     DateTime?
  totalMinutes Int?
  isApproved   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId, staffId])
  @@index([clockIn])
}

// ---------------------------------------------------------
// 9. ORDERS, PAYMENTS & KITCHEN TICKETS (M4/M5)
// ---------------------------------------------------------

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique // e.g. "EMBA-20260820-1423-047"
  dailySequence Int
  locationId    String
  terminalId    String
  orderType     OrderType     @default(DINE_IN)
  orderStatus   OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod PaymentMethod @default(CARD)
  paymentStatus PaymentStatus @default(PENDING)
  paymentRef    String?

  subtotal       Decimal       @db.Decimal(10, 2)
  vatAmount      Decimal       @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(10, 2) // promotions + voucher + staff discount (already deducted from totalAmount)
  voucherCode    String?
  promotionCodes String?       // JSON array of applied automatic promotion codes

  customerNote String?
  locale       String  @default("en")

  createdAt          DateTime  @default(now())
  paidAt             DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  location       Location        @relation(fields: [locationId], references: [id])
  terminal       Terminal        @relation(fields: [terminalId], references: [id])
  items          OrderItem[]
  kitchenTickets KitchenTicket[]
  syncQueue      SyncQueue[]

  voucherRedemptions VoucherRedemption[]

  @@index([locationId, orderStatus])
  @@index([terminalId, createdAt])
  @@index([orderNumber])
  @@index([createdAt])
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  PENDING_PAYMENT
  PAID
  PREPARING
  READY
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  NFC_WALLET
  QR_CODE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model OrderItem {
  id             String      @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  productSku     String
  basePrice      Decimal     @db.Decimal(10, 2)
  quantity       Int         @default(1)
  spiceLevel     Int         @default(1)
  vatCategory    VatCategory @default(FOOD_BEV)
  vatRate        Decimal     @db.Decimal(5, 4)
  netAmount      Decimal     @db.Decimal(10, 2)
  vatAmount      Decimal     @db.Decimal(10, 2)
  isMealBundle   Boolean     @default(false)
  mealDrinkName  String?
  mealSideName   String?
  mealPriceAddon Decimal     @default(0.00) @db.Decimal(10, 2)
  itemNotes      String?
  totalPrice     Decimal     @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id])
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemModifier {
  id              String   @id @default(cuid())
  orderItemId     String
  modifierId      String
  groupName       String
  modifierName    String
  priceAdjustment Decimal  @default(0.00) @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  Modifier  @relation(fields: [modifierId], references: [id])

  @@index([orderItemId])
  @@index([modifierId])
}

model KitchenTicket {
  id            String       @id @default(cuid())
  orderId       String
  orderNumber   String
  orderType     OrderType
  station       String       @default("ALL") // "ALL", "GRILL", "ASSEMBLY", "FRYER"
  ticketData    String // JSON payload
  ticketStatus  TicketStatus @default(QUEUED)
  claimedBy     String?
  printedAt     DateTime?
  printerError  String?
  printAttempts Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([ticketStatus])
  @@index([orderId])
  @@index([createdAt])
}

enum TicketStatus {
  QUEUED
  IN_PREPARATION
  READY
  COMPLETED
  VOIDED
  CANCELLED
  PRINTING
  PRINTED
  FAILED
  DISPATCHED_TO_KDS
}

// ---------------------------------------------------------
// 10. M10: DIGITAL MENU BOARD CMS
// ---------------------------------------------------------

model MenuBoardConfig {
  id            String   @id @default(cuid())
  screenNumber  Int      @unique // 1 to 7
  title         String // e.g. "Screen 2: Döner Selection"
  layoutType    String // "PROMO_HERO", "PRICE_MATRIX", "SPLIT_COMBO"
  activeDaypart String   @default("AUTO") // "AUTO", "LUNCH", "DINNER"
  itemsJson     String // Configured products, badges, and promos
  isOnline      Boolean  @default(true)
  lastPing      DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------
// 10b. PORTRAIT-SCREEN ADS (images and video on the 4 menu-board screens)
// [ADR] Context: the 4 portrait screens are the same TVs as the menu boards (Sagar, 2026-10-30).
// Decision: AdDisplay.screenNumber uses the same numbering as MenuBoardConfig.screenNumber;
// ads live in their own tables, so the menu-board data is untouched.
// Consequence: a screen can be addressed by one number for both menu and ads.
// ---------------------------------------------------------

enum AdMediaType {
  IMAGE
  VIDEO
}

model AdMedia {
  id         String      @id @default(cuid())
  fileName   String // original upload name, shown in admin only
  mediaType  AdMediaType
  mimeType   String
  byteSize   Int
  sha256     String      @unique // content address; also the cache key on the screens
  storageKey String      @unique // path under MEDIA_ROOT
  width      Int?
  height     Int?
  durationMs Int? // measured video length
  uploadedBy String?
  createdAt  DateTime    @default(now())

  playlistItems AdPlaylistItem[]
}

model AdPlaylist {
  id        String   @id @default(cuid())
  name      String   @unique
  timeZone  String   @default("Asia/Nicosia") // schedules are read in this zone
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    AdPlaylistItem[]
  displays AdDisplay[]
}

model AdPlaylistItem {
  id              String    @id @default(cuid())
  playlistId      String
  mediaId         String
  position        Int
  durationSeconds Int? // required for images; optional cap for videos
  startsAt        DateTime? // inclusive
  endsAt          DateTime? // exclusive
  daysOfWeek      Int[]     @default([]) // ISO 1 = Mon … 7 = Sun; empty = every day
  startMinute     Int? // minutes after local midnight, inclusive
  endMinute       Int? // exclusive; start > end crosses midnight
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  playlist AdPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  media    AdMedia    @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([playlistId, position])
  @@index([mediaId])
}

enum AdOrientation {
  PORTRAIT
  LANDSCAPE
}

model AdDisplay {
  id           String    @id @default(cuid())
  screenNumber Int       @unique // 1–4 = menu boards (MenuBoardConfig numbers); 5–6 = landscape drinks TVs
  name         String
  orientation  AdOrientation @default(PORTRAIT)
  playlistId   String?
  lastSeenAt   DateTime?
  appVersion   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  playlist AdPlaylist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)

  @@index([playlistId])
}

// ---------------------------------------------------------
// 11. SECURITY, AUDIT LOGS & DISASTER RECOVERY SYNC
// ---------------------------------------------------------

model AdminUser {
  id             String    @id @default(cuid())
  username       String    @unique
  pinHash        String // Bcrypt hashed 4-6 digit staff PIN
  role           AdminRole @default(STORE_STAFF)
  isActive       Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  auditLogs AuditLog[]

  @@index([username])
  @@index([isActive])
}

enum AdminRole {
  STORE_STAFF
  STORE_MANAGER
  SYSTEM_ADMIN
}

model AuditLog {
  id          String   @id @default(cuid())
  locationId  String?
  terminalId  String?
  adminUserId String?
  action      String
  details     String?
  ipAddress   String?
  severity    String   @default("INFO")
  createdAt   DateTime @default(now())

  location  Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  terminal  Terminal?  @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([severity])
  @@index([createdAt])
}

model SyncQueue {
  id         String     @id @default(cuid())
  orderId    String?
  entityType String
  payload    String
  status     SyncStatus @default(PENDING)
  retryCount Int        @default(0)
  lastError  String?
  syncedAt   DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}

enum SyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED_RETRYING
  PERMANENT_FAIL
}

enum VatCategory {
  FOOD_BEV
  ALCOHOL
  ZERO
}

/// VAT rate per category with history (PRD M11.4). Prices are VAT-inclusive; rates are never hard-coded.
/// The rate in force on a date is the row with the latest validFrom <= date and validTo null or > date.
model VatRate {
  id        String      @id @default(cuid())
  category  VatCategory
  rate      Decimal     @db.Decimal(5, 4) // fraction: 0.0900 means 9%
  validFrom DateTime
  validTo   DateTime?
  note      String? // legal basis, e.g. contract clause
  createdAt DateTime    @default(now())

  @@unique([category, validFrom])
  @@index([category, validFrom])
}

// ---------------------------------------------------------
// DISCOUNTS: AUTOMATIC PROMOTIONS & VOUCHERS / GIFT CARDS
// ---------------------------------------------------------

enum VoucherKind {
  PERCENT    // value = percent off the remaining total
  FIXED      // value = euro amount off
  GIFT_CARD  // balance = remaining euro credit; spent across several orders
}

model Promotion {
  id        String   @id @default(cuid())
  code      String   @unique // "PIZZA-2ND-20"
  name      String
  ruleJson  String   // PromotionRule JSON, see src/lib/menu/mygd-menu.ts
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Voucher {
  id             String      @id @default(cuid())
  code           String      @unique // stored upper-case
  kind           VoucherKind
  value          Decimal     @default(0.00) @db.Decimal(10, 2)
  minSubtotal    Decimal     @default(0.00) @db.Decimal(10, 2)
  validFrom      DateTime?
  validUntil     DateTime?
  maxRedemptions Int?        // null = unlimited
  redemptions    Int         @default(0)
  balance        Decimal?    @db.Decimal(10, 2) // GIFT_CARD only
  isActive       Boolean     @default(true)
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  log VoucherRedemption[]

  @@index([isActive])
}

model VoucherRedemption {
  id        String   @id @default(cuid())
  voucherId String
  orderId   String
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([voucherId, orderId])
  @@index([orderId])
}

// ---------------------------------------------------------
// Shift checklists from Oliver's operations manual (24 Oct 2026). Additive: the old
// ChecklistTemplate/ChecklistLog tables stay as they are and new code does not use them.
// [ADR] Context: tasks need per-item who/when/sign-off, which JSON columns can't give.
// Decision: tasks live in rows loaded from data/checklists; a run is one station + phase + day.
// Consequence: a task or station can change without a code change; staff ids here are snapshots
// (plain text, no foreign key) so history survives a staff member being removed.
// ---------------------------------------------------------
enum ChecklistPhase {
  OPENING
  DURING_SHIFT
  CLOSING
}

enum ChecklistSectionMode {
  TICK
  COUNT
  CHECK_IN
  REFERENCE_PER_ORDER
}

enum ChecklistItemKind {
  CHECK
  TEMPERATURE
  COUNT
}

enum ChecklistEntryStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  ISSUE_BLOCKED
}

enum ChecklistRunStatus {
  OPEN
  COMPLETED
}

enum StockStatus {
  OK
  LOW
  OUT
}

model ChecklistSection {
  id          String               @id @default(cuid())
  station     String
  stationName String
  phase       ChecklistPhase
  title       String
  mode        ChecklistSectionMode
  position    Int
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  items    ChecklistItem[]
  checkIns ChecklistCheckIn[]

  @@unique([station, phase, title])
  @@index([isActive, position])
}

model ChecklistItem {
  id          String            @id @default(cuid())
  sectionId   String
  position    Int
  label       String
  kind        ChecklistItemKind @default(CHECK)
  isCritical  Boolean           @default(false)
  haccpTarget String? // CHILLED | FROZEN | HOT_HOLDING
  needsReview String?
  sourcePage  Int?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  section ChecklistSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  entries ChecklistEntry[]

  @@unique([sectionId, position])
}

model ChecklistRun {
  id              String             @id @default(cuid())
  locationId      String
  station         String
  phase           ChecklistPhase
  shiftDate       DateTime           @db.Date
  status          ChecklistRunStatus @default(OPEN)
  completedById   String?
  completedByName String?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  location Location           @relation(fields: [locationId], references: [id])
  entries  ChecklistEntry[]
  checkIns ChecklistCheckIn[]

  @@unique([locationId, station, phase, shiftDate])
  @@index([locationId, shiftDate])
}

model ChecklistEntry {
  id               String               @id @default(cuid())
  runId            String
  itemId           String
  status           ChecklistEntryStatus @default(NOT_STARTED)
  temperature      Float?
  isCompliant      Boolean?
  correctiveAction String?
  note             String?
  recordedById     String?
  recordedByName   String?
  recordedAt       DateTime?
  verifiedById     String?
  verifiedByName   String?
  verifiedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  run  ChecklistRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  item ChecklistItem @relation(fields: [itemId], references: [id])

  @@unique([runId, itemId])
  @@index([itemId])
}

model ChecklistCheckIn {
  id             String   @id @default(cuid())
  runId          String
  sectionId      String
  recordedById   String
  recordedByName String
  createdAt      DateTime @default(now())

  run     ChecklistRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  section ChecklistSection @relation(fields: [sectionId], references: [id])

  @@index([runId, sectionId, createdAt])
  @@index([sectionId])
}

model StockItem {
  id          String   @id @default(cuid())
  category    String
  product     String
  position    Int
  snapshot    String // Last count from the manual, as written ("9 bags + 4 boxes")
  lowAt       Float? // LOW level, not set until Oliver gives one
  needsReview String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  counts StockCount[]

  @@unique([category, product])
  @@index([isActive, position])
}

model StockCount {
  id             String       @id @default(cuid())
  stockItemId    String
  locationId     String
  shiftDate      DateTime     @db.Date
  count          Float?
  status         StockStatus?
  recordedById   String
  recordedByName String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  location  Location  @relation(fields: [locationId], references: [id])

  @@unique([stockItemId, locationId, shiftDate])
  @@index([locationId, shiftDate])
}

model OperationalSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}
