// MY GERMAN DÖNER — Master Connected Operations Schema
// Covers Modules M1 to M11 (Layer 2 In-Store Edge + Layer 3 Cloud HQ)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// 1. MULTI-LOCATION TENANCY & HARDWARE TERMINALS
// ---------------------------------------------------------

model Location {
  id          String   @id @default(cuid())
  slug        String   @unique // e.g. "EMBA", "LIMASSOL"
  name        String   // "MY GERMAN DÖNER — Emba (Paphos)"
  nameDE      String?
  nameGR      String?
  address     String
  city        String   @default("Paphos")
  country     String   @default("CY")
  currency    String   @default("EUR")
  vatRate     Float    @default(0.19) // 19% Cyprus standard VAT
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  terminals       Terminal[]
  locationPrices  LocationPrice[]
  orders          Order[]
  auditLogs       AuditLog[]
  inventoryItems  InventoryItem[]
  checklistLogs   ChecklistLog[]
  haccpLogs       HaccpLog[]
  shiftSchedules  ShiftSchedule[]
  timeLogs        TimeLog[]
  staffShifts     StaffShift[]
  supplierOrders  SupplierOrder[]

  @@index([slug])
  @@index([isActive])
}

model Terminal {
  id              String       @id @default(cuid())
  locationId      String
  terminalCode    String       // e.g. "KIOSK-01", "POS-01", "KDS-01", "DISPLAY-01"
  terminalType    TerminalType @default(KIOSK)
  ipAddress       String?
  macAddress      String?
  printerType     PrinterType  @default(EPSON_TM)
  printerIp       String?
  printerPort     Int          @default(9100)
  autoCutReceipt  Boolean      @default(true)
  kioskModeLocked Boolean      @default(true)
  isActive        Boolean      @default(true)
  lastHeartbeat   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  location  Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  orders    Order[]
  auditLogs AuditLog[]

  @@unique([locationId, terminalCode])
  @@index([locationId])
  @@index([isActive])
}

enum TerminalType {
  KIOSK
  POS_COUNTER
  KITCHEN_DISPLAY
  MANAGER_TABLET
  CUSTOMER_DISPLAY
  MENU_BOARD
}

enum PrinterType {
  EPSON_TM
  STAR_MICRONICS
  SIMULATED_SCREEN
}

// ---------------------------------------------------------
// 2. MASTER PRODUCT CATALOG & PRICING (M11)
// ---------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique // "doner-kebab", "doner-box", "durum-wraps", "sides", "drinks"
  name        String   // English
  nameDE      String   // German
  nameGR      String   // Greek
  description String?
  iconSvg     String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([sortOrder])
  @@index([isActive])
}

model Product {
  id               String   @id @default(cuid())
  categoryId       String
  sku              String   @unique // e.g. "MYGD-CL-DONER"
  name             String
  nameDE           String?
  nameGR           String?
  description      String?
  descriptionDE    String?
  descriptionGR    String?
  basePrice        Float    // Default EUR base price (e.g. 7.50)
  imageUrl         String?
  badge            String?  // "POPULAR", "NEW", "VEGGIE", "SPICY", "CHEF_CHOICE"
  calories         Int?
  allergens        String?  // JSON array: ["Gluten", "Dairy", "Sesame"]
  vatCategory      VatCategory @default(FOOD_BEV)
  isVeggie         Boolean     @default(false)
  isSpicy          Boolean     @default(false)
  isAvailable      Boolean     @default(true)
  allowMealUpgrade Boolean     @default(true)
  sortOrder        Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifierGroups ProductModifierGroup[]
  locationPrices LocationPrice[]
  orderItems     OrderItem[]
  recipes        Recipe[]
  recipeBoms     RecipeBOM[]
  buildSheets    RecipeStep[]

  @@index([categoryId])
  @@index([isAvailable])
  @@index([sortOrder])
}

model LocationPrice {
  id          String   @id @default(cuid())
  locationId  String
  productId   String
  price       Float    // Location-specific price override
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([locationId])
  @@index([productId])
}

// ---------------------------------------------------------
// 3. MODIFIERS & CUSTOMIZATION RULES
// ---------------------------------------------------------

model ModifierGroup {
  id          String   @id @default(cuid())
  slug        String   @unique // "meat-choice", "bread-choice", "sauces", "extras"
  name        String
  nameDE      String?
  nameGR      String?
  minSelected Int      @default(0)
  maxSelected Int      @default(1)
  isRequired  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modifiers Modifier[]
  products  ProductModifierGroup[]

  @@index([sortOrder])
}

model Modifier {
  id              String   @id @default(cuid())
  modifierGroupId String
  slug            String
  name            String
  nameDE          String?
  nameGR          String?
  priceAdjustment Float    @default(0.00)
  isDefault       Boolean  @default(false)
  isAvailable     Boolean  @default(true)
  calories        Int?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modifierGroup ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderItemMods OrderItemModifier[]

  @@unique([modifierGroupId, slug])
  @@index([modifierGroupId])
  @@index([isAvailable])
}

model ProductModifierGroup {
  id              String   @id @default(cuid())
  productId       String
  modifierGroupId String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, modifierGroupId])
  @@index([productId])
  @@index([modifierGroupId])
}

// ---------------------------------------------------------
// 4. GRAM-PRECISION BILL OF MATERIALS (BOM) & INVENTORY (M3)
// ---------------------------------------------------------

model Ingredient {
  id             String   @id @default(cuid())
  sku            String   @unique // "ING-BEEF-SPIT", "ING-FLADENBROT"
  name           String
  unit           String   @default("GRAMS") // "GRAMS", "PIECES", "MILLILITERS"
  costPerUnitEUR Float    @default(0.00)
  supplierId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  recipeIngredients RecipeIngredient[]
  recipeBoms        RecipeBOM[]
  inventoryItems    InventoryItem[]

  @@index([sku])
}

model Recipe {
  id          String   @id @default(cuid())
  productId   String
  variantName String   @default("STANDARD_150G")
  yieldServings Int    @default(1)
  prepTimeSec Int      @default(180)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@index([productId])
}

model RecipeIngredient {
  id           String   @id @default(cuid())
  recipeId     String
  ingredientId String
  amountUnits  Float    // e.g. 150.0 grams of meat, 1.0 piece of bread
  isOptional   Boolean  @default(false)
  createdAt    DateTime @default(now())

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
}

model RecipeBOM {
  id           String   @id @default(cuid())
  productId    String
  ingredientId String
  amountGrams  Float    // Gram-level portion weight (e.g. 150.0g spit meat)
  isOptional   Boolean  @default(false)
  createdAt    DateTime @default(now())

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@index([productId])
  @@index([ingredientId])
}

model InventoryItem {
  id               String   @id @default(cuid())
  locationId       String
  ingredientId     String
  currentStock     Float    @default(0.0)
  minThreshold     Float    @default(5000.0) // In unit (e.g. 5000g = 5kg)
  reorderBatchSize Float    @default(20000.0)
  lastRestockedAt  DateTime?
  updatedAt        DateTime @updatedAt

  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([locationId, ingredientId])
  @@index([locationId])
  @@index([ingredientId])
}

// ---------------------------------------------------------
// 5. M8: MCDONALD'S-STYLE VISUAL BUILD SHEETS
// ---------------------------------------------------------

model RecipeStep {
  id           String   @id @default(cuid())
  productId    String
  stepNumber   Int
  instruction  String
  instructionDE String?
  imageUrl     String?
  targetSec    Int      @default(30)
  qualityCheck String?  // e.g. "Ensure internal meat temp > 75°C"
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, stepNumber])
  @@index([productId])
}

// ---------------------------------------------------------
// 6. M2: SUPPLIER 1-TAP REORDERING & DISPATCH
// ---------------------------------------------------------

model Supplier {
  id           String   @id @default(cuid())
  name         String   // "Berlin Döner Fleischerei GmbH", "Paphos Fresh Bakery"
  category     String   // "MEAT", "BAKERY", "PRODUCE", "SAUCES", "PACKAGING"
  contactName  String?
  whatsApp     String   // e.g. "+35799112233"
  email        String
  leadTimeHours Int     @default(24)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  ingredients    Ingredient[]
  supplierOrders SupplierOrder[]

  @@index([category])
}

model SupplierOrder {
  id            String      @id @default(cuid())
  locationId    String
  supplierId    String
  orderNumber   String      @unique // e.g. "SUP-EMBA-20260820-001"
  status        String      @default("PENDING") // PENDING, SENT_WHATSAPP, CONFIRMED, DELIVERED
  totalEUR         Float       @default(0.0)
  itemsJson        String      // JSON snapshot of ordered quantities and SKUs
  pinApprovalToken String?     // Token generated when >€250 approval is required
  approvedByPin    String?     // 4-digit PIN of owner (Rico / Oliver)
  dispatchedAt     DateTime?
  expectedDelivery DateTime?
  createdAt     DateTime    @default(now())

  location Location @relation(fields: [locationId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([locationId, status])
  @@index([supplierId])
}

// ---------------------------------------------------------
// 7. M1: DIGITAL CHECKLISTS & HACCP LOGBOOK
// ---------------------------------------------------------

model ChecklistTemplate {
  id          String   @id @default(cuid())
  title       String   // "Morning Opening SOP", "HACCP Temperature Audit", "Night Closing"
  shiftType   String   // "OPENING", "MID_DAY", "CLOSING", "HACCP"
  tasksJson   String   // JSON list of required checks and temperature targets
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ChecklistLog {
  id          String   @id @default(cuid())
  locationId  String
  shiftType   String
  completedBy String   // Staff name or ID
  isCompliant Boolean  @default(true)
  logsJson    String   // Recorded values, temperature logs, photos
  notes       String?
  createdAt   DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId, createdAt])
}

model HaccpLog {
  id               String   @id @default(cuid())
  locationId       String
  equipmentName    String   // "Walk-in Fridge 1", "Deep Freezer", "Rotisserie Spit"
  targetType       String   // "CHILLED" (0-5°C), "FROZEN" (-18 to -22°C), "HOT_HOLDING" (>=63°C)
  temperature      Float    // Recorded temperature in Celsius
  isCompliant      Boolean  // True if within statutory limits
  correctiveAction String?  // Mandatory explanation if in Danger Zone (5°C - 63°C)
  loggedBy         String   // Staff name or PIN
  createdAt        DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId, createdAt])
  @@index([isCompliant])
}

// ---------------------------------------------------------
// 8. M7: SHIFT SCHEDULING & PIN TIMECLOCK
// ---------------------------------------------------------

model ShiftSchedule {
  id          String   @id @default(cuid())
  locationId  String
  staffId     String
  staffName   String
  role        String   // "CASHIER", "GRILL_MASTER", "ASSEMBLER", "MANAGER"
  startTime   DateTime
  endTime     DateTime
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId, startTime])
}

model TimeLog {
  id          String    @id @default(cuid())
  locationId  String
  staffId     String
  staffName   String
  role        String
  clockIn     DateTime  @default(now())
  clockOut    DateTime?
  totalMinutes Int?
  isApproved  Boolean   @default(false)

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId, staffId])
  @@index([clockIn])
}

model StaffShift {
  id           String    @id @default(cuid())
  locationId   String
  staffId      String
  staffName    String
  role         String    // "CASHIER", "GRILL_MASTER", "ASSEMBLER", "MANAGER"
  pin          String?   // 4-digit PIN used for timeclock
  clockIn      DateTime  @default(now())
  clockOut     DateTime?
  totalMinutes Int?
  isApproved   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId, staffId])
  @@index([clockIn])
}

// ---------------------------------------------------------
// 9. ORDERS, PAYMENTS & KITCHEN TICKETS (M4/M5)
// ---------------------------------------------------------

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique // e.g. "EMBA-20260820-1423-047"
  dailySequence   Int
  locationId      String
  terminalId      String
  orderType       OrderType     @default(DINE_IN)
  orderStatus     OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod   PaymentMethod @default(CARD)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentRef      String?

  subtotal        Float
  vatRate         Float         @default(0.19)
  vatAmount       Float
  totalAmount     Float

  customerNote    String?
  locale          String        @default("en")

  createdAt       DateTime      @default(now())
  paidAt          DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancellationReason String?

  location       Location        @relation(fields: [locationId], references: [id])
  terminal       Terminal        @relation(fields: [terminalId], references: [id])
  items          OrderItem[]
  kitchenTickets KitchenTicket[]
  syncQueue      SyncQueue[]

  @@index([locationId, orderStatus])
  @@index([terminalId, createdAt])
  @@index([orderNumber])
  @@index([createdAt])
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  PENDING_PAYMENT
  PAID
  PREPARING
  READY
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  NFC_WALLET
  QR_CODE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  productSku     String
  basePrice      Float
  quantity       Int         @default(1)
  spiceLevel     Int         @default(1)
  vatCategory    VatCategory @default(FOOD_BEV)
  isMealBundle   Boolean     @default(false)
  mealDrinkName  String?
  mealSideName   String?
  mealPriceAddon Float    @default(0.00)
  itemNotes      String?
  totalPrice     Float
  createdAt      DateTime @default(now())

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id])
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemModifier {
  id              String   @id @default(cuid())
  orderItemId     String
  modifierId      String
  groupName       String
  modifierName    String
  priceAdjustment Float    @default(0.00)
  createdAt       DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  Modifier  @relation(fields: [modifierId], references: [id])

  @@index([orderItemId])
  @@index([modifierId])
}

model KitchenTicket {
  id            String       @id @default(cuid())
  orderId       String
  orderNumber   String
  orderType     OrderType
  station       String       @default("ALL") // "ALL", "GRILL", "ASSEMBLY", "FRYER"
  ticketData    String       // JSON payload
  ticketStatus  TicketStatus @default(QUEUED)
  claimedBy     String?
  printedAt     DateTime?
  printerError  String?
  printAttempts Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([ticketStatus])
  @@index([orderId])
  @@index([createdAt])
}

enum TicketStatus {
  QUEUED
  IN_PREPARATION
  READY
  COMPLETED
  VOIDED
  CANCELLED
  PRINTING
  PRINTED
  FAILED
  DISPATCHED_TO_KDS
}

// ---------------------------------------------------------
// 10. M10: DIGITAL MENU BOARD CMS
// ---------------------------------------------------------

model MenuBoardConfig {
  id           String   @id @default(cuid())
  screenNumber Int      @unique // 1 to 7
  title        String   // e.g. "Screen 2: Döner Selection"
  layoutType   String   // "PROMO_HERO", "PRICE_MATRIX", "SPLIT_COMBO"
  activeDaypart String  @default("AUTO") // "AUTO", "LUNCH", "DINNER"
  itemsJson    String   // Configured products, badges, and promos
  isOnline     Boolean  @default(true)
  lastPing     DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------
// 11. SECURITY, AUDIT LOGS & DISASTER RECOVERY SYNC
// ---------------------------------------------------------

model AdminUser {
  id             String    @id @default(cuid())
  username       String    @unique
  pinHash        String    // Bcrypt hashed 4-6 digit staff PIN
  role           AdminRole @default(STORE_STAFF)
  isActive       Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  auditLogs AuditLog[]

  @@index([username])
  @@index([isActive])
}

enum AdminRole {
  STORE_STAFF
  STORE_MANAGER
  SYSTEM_ADMIN
}

model AuditLog {
  id          String   @id @default(cuid())
  locationId  String?
  terminalId  String?
  adminUserId String?
  action      String
  details     String?
  ipAddress   String?
  severity    String   @default("INFO")
  createdAt   DateTime @default(now())

  location  Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  terminal  Terminal?  @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([severity])
  @@index([createdAt])
}

model SyncQueue {
  id         String     @id @default(cuid())
  orderId    String?
  entityType String
  payload    String
  status     SyncStatus @default(PENDING)
  retryCount Int        @default(0)
  lastError  String?
  syncedAt   DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}

enum SyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED_RETRYING
  PERMANENT_FAIL
}

enum VatCategory {
  FOOD_BEV
  ALCOHOL
  ZERO
}

